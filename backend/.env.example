# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins (the React dev server / your domain)
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ocean_paradise

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Used ONLY by `npm run setup` to create the first admin (min 10 characters).
# Change the password from the admin panel after first login.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
